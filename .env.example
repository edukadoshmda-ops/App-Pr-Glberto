# =========================================================
# ELITEFLOW - ARQUIVO DE CONFIGURAÇÃO (.env)
# =========================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env (renomeie quando em produção)
# 2. Configure as variáveis conforme seu ambiente
# 3. NUNCA faça commit do .env com dados sensíveis no Git
# 4. Adicione .env ao .gitignore
# =========================================================

# =========================================================
# SERVER CONFIGURATION
# =========================================================

# Porta de execução
PORT=3000

# Ambiente (development, staging, production)
NODE_ENV=development

# Host
HOST=localhost

# =========================================================
# DATABASE CONFIGURATION
# =========================================================

# Tipo de banco (json, mongodb, postgresql)
DB_TYPE=json

# Se usar MongoDB
# DB_MONGODB_URI=mongodb://user:password@localhost:27017/eliteflow
# DB_MONGODB_NAME=eliteflow

# Se usar PostgreSQL
# DB_POSTGRESQL_HOST=localhost
# DB_POSTGRESQL_PORT=5432
# DB_POSTGRESQL_USER=eliteflow
# DB_POSTGRESQL_PASSWORD=sua_senha
# DB_POSTGRESQL_DATABASE=eliteflow

# =========================================================
# CORS & SEGURANÇA
# =========================================================

# Origins permitidas (separe com vírgula)
CORS_ORIGIN=http://localhost:3000,http://localhost,http://127.0.0.1

# Habilitar HTTPS (false em dev, true em prod)
ENABLE_HTTPS=false

# =========================================================
# UPLOAD CONFIGURATION
# =========================================================

# Tamanho máximo de arquivo (em bytes)
MAX_FILE_SIZE=104857600

# Tamanho máximo de requisição (em bytes)
MAX_REQUEST_SIZE=52428800

# Diretórios de upload
UPLOAD_VIDEOS_DIR=assets/videos
UPLOAD_ARTICLES_DIR=assets/artigos/capas
UPLOAD_PDFS_DIR=assets/artigos/pdfs
UPLOAD_PROJECTS_DIR=assets/projetos

# =========================================================
# AUTENTICAÇÃO
# =========================================================

# JWT Secret (gere um seguro em produção)
JWT_SECRET=sua_chave_secreta_muito_segura_aqui_123456789

# JWT Expiration (em horas)
JWT_EXPIRATION=24

# =========================================================
# SESSION
# =========================================================

# Session timeout (em minutos)
SESSION_TIMEOUT=30

# Enable session storage
ENABLE_SESSION_STORAGE=true

# =========================================================
# LOGGING
# =========================================================

# Nível de log (error, warn, info, debug)
LOG_LEVEL=info

# Arquivo de log
LOG_FILE=logs/app.log

# Rotação de logs (daily, weekly, monthly)
LOG_ROTATION=daily

# =========================================================
# RATE LIMITING
# =========================================================

# Enable rate limiting
ENABLE_RATE_LIMIT=true

# Requisições por janela de tempo
RATE_LIMIT_REQUESTS=100

# Janela de tempo (em minutos)
RATE_LIMIT_WINDOW=15

# =========================================================
# EMAIL CONFIGURATION (Para notificações futuras)
# =========================================================

# SMTP Host
SMTP_HOST=smtp.gmail.com

# SMTP Port
SMTP_PORT=587

# SMTP User
SMTP_USER=seu_email@gmail.com

# SMTP Password
SMTP_PASSWORD=sua_senha_app

# From Email
SMTP_FROM=noreply@eliteflow.com

# =========================================================
# API EXTERNAL (Para integrações futuras)
# =========================================================

# Google Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Stripe (para pagamentos)
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# =========================================================
# RECURSOS
# =========================================================

# Habilitar features beta
ENABLE_BETA_FEATURES=false

# Modo manutenção
MAINTENANCE_MODE=false

# =========================================================
# INTEGRAÇÃO EXTERNA
# =========================================================

# Enable external APIs
ENABLE_EXTERNAL_API=true

# API Timeout (em ms)
API_TIMEOUT=30000

# =========================================================
# STORAGE CONFIGURAÇÃO
# =========================================================

# Tipo de storage (local, s3, gcs)
STORAGE_TYPE=local

# Se usar AWS S3
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_S3_BUCKET=eliteflow-bucket
# AWS_S3_REGION=us-east-1

# =========================================================
# CACHE CONFIGURATION
# =========================================================

# Enable cache
ENABLE_CACHE=true

# Cache type (memory, redis)
CACHE_TYPE=memory

# Cache TTL (em segundos)
CACHE_TTL=3600

# Se usar Redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=sua_senha

# =========================================================
# FEATURES CONFIGURATION
# =========================================================

# Habilitar upload de vídeos
ENABLE_VIDEOS=true

# Habilitar artigos
ENABLE_ARTICLES=true

# Habilitar relatórios
ENABLE_REPORTS=true

# Habilitar projetos
ENABLE_PROJECTS=true

# Habilitar audiobooks
ENABLE_AUDIOBOOKS=true

# =========================================================
# DESENVOLVIMENTO
# =========================================================

# Debug mode
DEBUG=false

# Verbose logging
VERBOSE_LOGGING=false

# Show SQL queries (se usar DB)
SHOW_QUERIES=false

# =========================================================
# NOTAS IMPORTANTES
# =========================================================

# 1. SEGURANÇA EM PRODUÇÃO:
#    - Sempre use valores aleatórios para JWT_SECRET
#    - Use .env.production com valores reais
#    - NUNCA comite .env com dados sensíveis
#    - Use variáveis de ambiente do hosting (Heroku, AWS, etc)
#    - Ative HTTPS
#    - Configure CORS_ORIGIN apenas com seus domínios

# 2. PARA COMEÇAR EM DESENVOLVIMENTO:
#    - Deixe as configurações padrão
#    - Apenas altere PORT se já estiver em uso
#    - NODE_ENV=development para logs detalhados
#    - CORS_ORIGIN=* apenas em desenvolvimento

# 3. ESTRUTURA DE DEPLOYMENT:
#    - development: .env (local)
#    - staging: .env.staging
#    - production: .env.production

# 4. VARIÁVEIS QUE DEVEM VARIAR POR AMBIENTE:
#    - DATABASE (dev usa JSON, prod usa PostgreSQL)
#    - CORS_ORIGIN (dev aceita localhost, prod aceita domínio)
#    - HTTPS (false em dev, true em prod)
#    - LOG_LEVEL (debug em dev, warn em prod)
#    - ENABLE_BETA_FEATURES (true em dev, false em prod)

# =========================================================
# COMANDO PARA GERAR JWT_SECRET SEGURO
# =========================================================

# Node.js:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Python:
# python3 -c "import secrets; print(secrets.token_hex(32))"

# OpenSSL:
# openssl rand -hex 32

# =========================================================
